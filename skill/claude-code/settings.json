{
  "permissions": {
    "deny": [
      "Bash(fabrica verdict *)",
      "Bash(fabrica answer *)",
      "Bash(rm *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(sudo *)",
      "Bash(dd *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git checkout -- *)",
      "Bash(git clean *)",
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ],
    "allow": [
      "Bash(fabrica do *)",
      "Bash(fabrica status *)",
      "Bash(fabrica log *)",
      "Bash(fabrica watch *)",
      "Bash(fabrica verify-hook *)",
      "Bash(fabrica)",
      "Bash(fabrica --help)",
      "Bash(fabrica -h)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(pwd)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Edit|Write|NotebookEdit|MultiEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "fabrica deny-and-log-edit"
          }
        ]
      }
    ]
  }
}
